# Database
DATABASE_URL="postgresql://moi:moi_dev_password@localhost:5433/moi_ledger?schema=public"

# Server
PORT=4000
NODE_ENV=development

# CORS: comma separated origins for guest + admin web
CORS_ORIGINS="http://localhost:5173,http://localhost:5174"

# Admin auth
JWT_SECRET="change-me-in-production-min-32-chars-long"
JWT_EXPIRES_IN="12h"

# Seed bootstrap admin (dev only)
SEED_ADMIN_EMAIL="admin@moiledger.local"
SEED_ADMIN_PASSWORD="ChangeMe#123"
SEED_ADMIN_NAME="Event Organizer"

# Public guest site base URL. The printed QR code is built from this,
# so it must be the deployed URL in production.
GUEST_WEB_URL="http://localhost:5173"

# NOTE: there is deliberately no platform-wide default UPI payee.
# Each event resolves its payee from the beneficiary account its own owner
# configured and confirmed. A global fallback would route a customer's guest
# payments into the platform's account when their event was misconfigured.

# Seed bootstrap platform operator (dev only)
SEED_SUPER_ADMIN_EMAIL="super@moiledger.local"
SEED_SUPER_ADMIN_PASSWORD="ChangeMe#123"

# Isolation tests run against a throwaway database that they reset on every
# run. Never point this at a database holding real data.
TEST_DATABASE_URL="postgresql://moi:moi_dev_password@localhost:5433/moi_test?schema=public"

# Guest limits
MIN_AMOUNT_PAISE=100
MAX_AMOUNT_PAISE=10000000
