{
  "name": "moi-ledger",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:api": "pnpm --filter @moi/api dev",
    "dev:guest": "pnpm --filter @moi/guest-web dev",
    "dev:admin": "pnpm --filter @moi/admin-web dev",
    "build": "pnpm -r build",
    "db:up": "docker compose -f infra/docker-compose.yml up -d",
    "db:down": "docker compose -f infra/docker-compose.yml down",
    "db:migrate": "pnpm --filter @moi/api prisma:migrate",
    "db:seed": "pnpm --filter @moi/api seed",
    "test": "pnpm -r test"
  },
  "dependencies": {
    "@neon/config": "^1.10.1",
    "@neon/env": "^1.6.9"
  }
}
